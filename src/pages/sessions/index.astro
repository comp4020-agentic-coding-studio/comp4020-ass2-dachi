---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <p>
    Twelve studio sessions, one a week except for the mid-semester break.
    Every one of them is a crit or a clinic, not a lecture — you leave having
    said or made something about a real door, not having listened to someone
    talk about one.
  </p>
  <SessionsGrid />
</ContentLayout>

<style is:global>
  /* Same card-title contrast fix as src/pages/index.astro — this page also
     renders through ContentLayout directly, bypassing PageLayout.astro. */
  .at-card-title {
    color: light-dark(var(--at-secondary), var(--at-primary));
  }
</style>
